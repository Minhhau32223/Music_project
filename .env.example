# Copy to .env for Docker Compose. Do not commit .env.
DB_URL=jdbc:postgresql://localhost:5432/music_app
DB_USERNAME=postgres
DB_PASSWORD=
POSTGRES_PORT=5432
JWT_SECRET=
JWT_EXPIRATION=6000000
JWT_REFRESH_EXPIRATION=604800000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
PORT=8000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://nocturne-music-hau.haunguyen23.chatgpt.site
# Production profile always uses Redis. Local Maven defaults to CACHE_TYPE=none.
CACHE_TYPE=none
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
API_DOCS_ENABLED=false
APP_SEED_ENABLED=false
DEV_SEED_PASSWORD=change-me-local
SEED_ADMIN_PASSWORD=change-me-local
MEDIA_SEED_ENABLED=false
MEDIA_SEED_DIR=./seed-media/music
MEDIA_SEED_IMAGE_DIR=./seed-media/background
